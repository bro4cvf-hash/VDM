import { Icon } from "../components/icon.slint";
import { CaptionBtn } from "../components/buttons.slint";
import { Palette } from "../theme.slint";

// ════════════════════════════════════════════════════════════════════
// Duplicate / Existing File Conflict Dialog (Apple / macOS Glass Style)
// ════════════════════════════════════════════════════════════════════
export component DuplicateDownloadDialog inherits Window {
    width: 540px;
    height: root.is-active-downloading ? 310px : 380px;
    no-frame: true;
    background: transparent;
    title: "Download File Conflict";
    default-font-family: "Segoe UI Variable Display, Segoe UI, Inter, -apple-system, sans-serif";

    in-out property <string> task-id: "";
    in-out property <string> filename: "";
    in-out property <string> new-suggested-name: "";
    in-out property <string> existing-status: "Already in download list";
    in-out property <string> existing-size-text: "—";
    in-out property <string> save-folder: "";
    in-out property <string> new-url: "";
    in-out property <bool> is-active-downloading: false;

    callback rename-and-download(string);
    callback resume-or-update-link(string, string);
    callback overwrite-existing(string, string);
    callback show-existing-progress(string);
    callback closed();
    callback drag-window();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: Palette.modal-bg;
        border-width: 1px;
        border-color: Palette.border-color;
        clip: true;

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // ── Top Title Bar (Seamlessly blended with background) ──
            Rectangle {
                height: 38px;

                TouchArea {
                    pointer-event(pe) => {
                        if (pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.drag-window();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;

                            Image {
                                source: @image-url("../icons/vdm.svg");
                                width: 16px;
                                height: 16px;
                            }
                        }

                        Text {
                            text: root.is-active-downloading ? "Download In Progress" : "File Already In List";
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    CaptionBtn {
                        glyph: "✕";
                        danger: true;
                        clicked => { root.closed(); }
                    }
                }
            }

            // ── Content Area ──
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 14px;
                spacing: 10px;

                // ── Info Header Card (Non-touchable notice card - darker recessed background) ──
                Rectangle {
                    border-radius: 10px;
                    background: Palette.surface-bg;
                    border-width: 1px;
                    border-color: Palette.border-color;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 7px;
                            background: root.is-active-downloading ? Palette.accent-tint-bg : #FF9F0A18;
                            border-width: 1px;
                            border-color: root.is-active-downloading ? Palette.border-subtle : #FF9F0A35;
                            y: (parent.height - self.height) / 2;

                            Icon {
                                source: root.is-active-downloading ? @image-url("../icons/zap.svg") : @image-url("../icons/alert.svg");
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: root.is-active-downloading ? Palette.accent-light : Palette.warning;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.is-active-downloading
                                    ? "This file is currently being downloaded"
                                    : "A download for this file already exists in your list";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Palette.text-primary;
                                overflow: elide;
                            }

                            Text {
                                text: root.filename;
                                font-size: 11.5px;
                                font-weight: 500;
                                color: Palette.accent-light;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                Text {
                                    text: "Status: " + root.existing-status;
                                    font-size: 10.5px;
                                    font-weight: 500;
                                    color: Palette.text-secondary;
                                    overflow: elide;
                                }

                                if root.existing-size-text != "" && root.existing-size-text != "—": Text {
                                    text: "Size: " + root.existing-size-text;
                                    font-size: 10.5px;
                                    font-weight: 500;
                                    color: Palette.text-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // ── Options List (Elevated interactive cards with uniform start alignment) ──
                VerticalLayout {
                    spacing: 8px;

                    // Option 1: Download as New File (Auto-Rename) [RECOMMENDED]
                    Rectangle {
                        height: 54px;
                        border-radius: 8px;
                        background: opt1-t.pressed ? Palette.hover-bg : opt1-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                        border-width: 1px;
                        border-color: opt1-t.pressed ? Palette.accent : opt1-t.has-hover ? Palette.border-color : Palette.border-subtle;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        opt1-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.rename-and-download(root.new-suggested-name != "" ? root.new-suggested-name : root.filename);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 7px;
                                background: Palette.accent-tint-bg;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                y: (parent.height - self.height) / 2;

                                Icon {
                                    source: @image-url("../icons/plus.svg");
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: Palette.accent;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: "Download as New File (Auto-Rename)";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        height: 16px;
                                        border-radius: 4px;
                                        background: Palette.accent-tint-bg;
                                        border-width: 1px;
                                        border-color: Palette.accent;
                                        y: (parent.height - self.height) / 2;

                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            alignment: center;

                                            Text {
                                                text: "RECOMMENDED";
                                                font-size: 9px;
                                                font-weight: 700;
                                                letter-spacing: 0.4px;
                                                color: Palette.accent;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: "Saves as \"" + root.new-suggested-name + "\" without affecting existing file";
                                    font-size: 11px;
                                    color: Palette.text-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Option 2 (Active Only): Show active downloading progress box
                    if root.is-active-downloading: Rectangle {
                        height: 54px;
                        border-radius: 8px;
                        background: opt-prog-t.pressed ? Palette.hover-bg : opt-prog-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                        border-width: 1px;
                        border-color: opt-prog-t.pressed ? Palette.success : opt-prog-t.has-hover ? Palette.border-color : Palette.border-subtle;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        opt-prog-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-existing-progress(root.task-id);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 7px;
                                background: #30D15820;
                                border-width: 1px;
                                border-color: #30D15840;
                                y: (parent.height - self.height) / 2;

                                Icon {
                                    source: @image-url("../icons/play.svg");
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: Palette.success;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "Show Active Download Box";
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Palette.text-primary;
                                }

                                Text {
                                    text: "Bring the active download progress window to front";
                                    font-size: 11px;
                                    color: Palette.text-secondary;
                                }
                            }
                        }
                    }

                    // Option 3 (Inactive): Resume & Update Address
                    if !root.is-active-downloading: Rectangle {
                        height: 54px;
                        border-radius: 8px;
                        background: opt2-t.pressed ? Palette.hover-bg : opt2-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                        border-width: 1px;
                        border-color: opt2-t.pressed ? Palette.accent : opt2-t.has-hover ? Palette.border-color : Palette.border-subtle;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        opt2-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.resume-or-update-link(root.task-id, root.new-url);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 7px;
                                background: Palette.accent-tint-bg;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                y: (parent.height - self.height) / 2;

                                Icon {
                                    source: @image-url("../icons/refresh.svg");
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: Palette.accent-light;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "Resume & Update Address";
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Palette.text-primary;
                                }

                                Text {
                                    text: "Refresh expired link and continue from where it stopped";
                                    font-size: 11px;
                                    color: Palette.text-secondary;
                                }
                            }
                        }
                    }

                    // Option 4 (Inactive): Overwrite & Restart
                    if !root.is-active-downloading: Rectangle {
                        height: 54px;
                        border-radius: 8px;
                        background: opt3-t.pressed ? Palette.hover-bg : opt3-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                        border-width: 1px;
                        border-color: opt3-t.pressed ? Palette.danger : opt3-t.has-hover ? Palette.border-color : Palette.border-subtle;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        opt3-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.overwrite-existing(root.task-id, root.new-url);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 7px;
                                background: #FF453A20;
                                border-width: 1px;
                                border-color: #FF453A40;
                                y: (parent.height - self.height) / 2;

                                Icon {
                                    source: @image-url("../icons/trash.svg");
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: Palette.danger;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "Overwrite & Restart";
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Palette.danger;
                                }

                                Text {
                                    text: "Replace the previous file and download afresh from 0%";
                                    font-size: 11px;
                                    color: Palette.text-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ── Footer Cancel Button ──
                HorizontalLayout {
                    alignment: end;

                    Rectangle {
                        height: 32px;
                        min-width: 80px;
                        border-radius: 6px;
                        background: cnl-t.pressed ? Palette.hover-bg : cnl-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;
                        animate background { duration: 120ms; }

                        cnl-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.closed(); }
                        }

                        Text {
                            text: "Cancel";
                            font-size: 12px;
                            font-weight: 500;
                            color: cnl-t.has-hover ? Palette.text-primary : Palette.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }
}

