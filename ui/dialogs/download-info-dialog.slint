import { Icon } from "../components/icon.slint";
import { CaptionBtn } from "../components/buttons.slint";
import { Field } from "../components/inputs.slint";

// ════════════════════════════════════════════════
// Download File Info Dialog (IDM-style Modern Glass)
// ════════════════════════════════════════════════
export component DownloadInfoDialog inherits Window {
    preferred-width: 540px;
    preferred-height: 285px;
    min-width: 480px;
    min-height: 275px;
    no-frame: true;
    background: transparent;
    title: "Download File Info";
    default-font-family: "Segoe UI Variable Display, Segoe UI, Inter, -apple-system, sans-serif";

    in-out property <string> url: "";
    in-out property <string> filename: "";
    in-out property <string> folder: "";
    in-out property <string> save-as: "";
    in-out property <string> category: "General";
    in-out property <string> description: "";
    in-out property <string> file-size-text: "—";
    in-out property <string> file-type: "file";
    in-out property <image> file-icon;
    in-out property <bool> has-sys-icon: false;
    in-out property <bool> remember-path: true;
    in-out property <bool> start-now: true;
    in-out property <bool> is-probing: false;
    in-out property <bool> category-dropdown-open: false;

    callback confirm(string, string, string, string, bool); // url, filename, folder, description, start-now
    callback pick-folder() -> string;
    callback category-changed(string);
    callback url-edited(string);
    callback filename-edited(string);
    callback closed();
    callback drag-window();
    callback minimize-window();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: #18181A;
        border-width: 1px;
        border-color: #2E2E32;
        drop-shadow-blur: 32px;
        drop-shadow-color: #000000cc;

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // ── Blended Integrated Header ──
            Rectangle {
                height: 36px;
                background: #141416;
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;

                TouchArea {
                    moved => { root.drag-window(); }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;

                            Image {
                                source: @image-url("../icons/vdm.svg");
                                width: 16px;
                                height: 16px;
                            }
                        }

                        Text {
                            text: "Download File Info";
                            font-size: 12.5px;
                            font-weight: 600;
                            color: #FFFFFF;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        CaptionBtn {
                            glyph: "─";
                            clicked => { root.minimize-window(); }
                        }
                        CaptionBtn {
                            glyph: "✕";
                            danger: true;
                            clicked => { root.closed(); }
                        }
                    }
                }
            }

            // ── Main Form Area ──
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 9px;

                // ── Row 1: File Name + Size + Category ──
                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    alignment: center;

                    // File Icon Container
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 7px;
                        background: #202024;
                        border-width: 1px;
                        border-color: #303034;

                        if root.has-sys-icon: Image {
                            source: root.file-icon;
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        if !root.has-sys-icon: Icon {
                            source: root.file-type == "video" ? @image-url("../icons/film.svg") :
                                    root.file-type == "audio" ? @image-url("../icons/music.svg") :
                                    root.file-type == "archive" ? @image-url("../icons/archive.svg") :
                                    root.file-type == "installer" ? @image-url("../icons/cpu.svg") :
                                    root.file-type == "image" ? @image-url("../icons/image.svg") :
                                    @image-url("../icons/file.svg");
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            tint: root.file-type == "video" ? #AF52DE :
                                  root.file-type == "audio" ? #30D158 :
                                  root.file-type == "archive" ? #FF9F0A :
                                  root.file-type == "installer" ? #0A84FF :
                                  root.file-type == "image" ? #64D2FF : #FF6B5E;
                        }
                    }

                    // Filename Input Field
                    Field {
                        h: 32px;
                        font-size: 12.5px;
                        radius: 6px;
                        pad-x: 10px;
                        placeholder: "Filename...";
                        text <=> root.filename;
                        horizontal-stretch: 1;
                        edited(t) => {
                            root.filename-edited(t);
                            root.save-as = root.folder + "\\" + t;
                        }
                    }

                    // File size badge
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: #202024;
                        border-width: 1px;
                        border-color: #303034;

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            spacing: 5px;
                            alignment: center;

                            Rectangle {
                                width: 11px;
                                height: 11px;
                                y: (parent.height - self.height) / 2;
                                Icon {
                                    source: @image-url("../icons/download.svg");
                                    width: 11px;
                                    height: 11px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: #0A84FF;
                                }
                            }

                            Text {
                                text: root.file-size-text != "" ? root.file-size-text : "—";
                                font-size: 11.5px;
                                font-weight: 600;
                                color: #E2E2E6;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Category Selector Button
                    Rectangle {
                        width: 110px;
                        height: 32px;
                        border-radius: 6px;
                        background: cat-t.has-hover ? #26262A : #202024;
                        border-width: 1px;
                        border-color: root.category-dropdown-open ? #0A84FF : #303034;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: space-between;

                            Text {
                                text: root.category;
                                font-size: 11.5px;
                                font-weight: 500;
                                color: #E2E2E6;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Icon {
                                source: @image-url("../icons/chevron.svg");
                                width: 9px;
                                height: 9px;
                                y: (parent.height - self.height) / 2;
                                tint: #98989D;
                                transform-rotation: root.category-dropdown-open ? 180deg : 0deg;
                                animate transform-rotation { duration: 150ms; }
                            }
                        }

                        cat-t := TouchArea {
                            clicked => { root.category-dropdown-open = !root.category-dropdown-open; }
                        }
                    }
                }

                // ── Row 2: URL Field ──
                VerticalLayout {
                    spacing: 3px;

                    Text {
                        text: "URL";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: #8E8E93;
                    }

                    Field {
                        h: 30px;
                        font-size: 12px;
                        radius: 6px;
                        pad-x: 10px;
                        placeholder: "https://...";
                        text <=> root.url;
                        edited(t) => { root.url-edited(t); }
                    }
                }

                // ── Row 3: Save Location Field ──
                VerticalLayout {
                    spacing: 3px;

                    Text {
                        text: "SAVE TO";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                        color: #8E8E93;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Field {
                            h: 30px;
                            font-size: 12px;
                            radius: 6px;
                            pad-x: 10px;
                            placeholder: "Save folder path...";
                            text <=> root.folder;
                            horizontal-stretch: 1;
                            edited(t) => { root.save-as = t + "\\" + root.filename; }
                        }

                        Rectangle {
                            width: 86px;
                            height: 30px;
                            border-radius: 6px;
                            background: br-touch.pressed ? #323236 :
                                        br-touch.has-hover ? #2A2A2E : #222225;
                            border-width: 1px;
                            border-color: br-touch.has-hover ? #404046 : #303034;
                            animate background { duration: 120ms; }

                            br-touch := TouchArea {
                                clicked => {
                                    root.folder = root.pick-folder();
                                    if (root.folder != "") {
                                        root.save-as = root.folder + "\\" + root.filename;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 5px;
                                alignment: center;

                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2;
                                    Icon {
                                        source: @image-url("../icons/folder.svg");
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: #D1D1D6;
                                    }
                                }

                                Text {
                                    text: "Browse…";
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Row 4: Remember Path Checkbox ──
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 15px;
                        height: 15px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.remember-path ? #0A84FF : #222225;
                        border-width: 1px;
                        border-color: root.remember-path ? #0A84FF : #404046;
                        animate background { duration: 120ms; }

                        TouchArea {
                            clicked => { root.remember-path = !root.remember-path; }
                        }

                        if root.remember-path: Icon {
                            source: @image-url("../icons/tick.svg");
                            width: 9px;
                            height: 9px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            tint: #FFFFFF;
                        }
                    }

                    Text {
                        text: "Remember this folder for \"" + root.category + "\" downloads";
                        font-size: 11.5px;
                        color: #B0B0B5;
                        vertical-alignment: center;

                        TouchArea {
                            clicked => { root.remember-path = !root.remember-path; }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ── Row 5: Footer Action Buttons ──
                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    // Left Status Text
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        if root.is-probing: Rectangle {
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            Icon {
                                source: @image-url("../icons/zap.svg");
                                width: 12px;
                                height: 12px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: #64D2FF;
                            }
                        }

                        Text {
                            text: root.is-probing ? "Probing server information…" : "";
                            font-size: 11px;
                            color: #64D2FF;
                            vertical-alignment: center;
                        }
                    }

                    // Right Buttons
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Cancel Button
                        Rectangle {
                            height: 32px;
                            min-width: 72px;
                            border-radius: 7px;
                            background: cancel-t.pressed ? #323236 :
                                        cancel-t.has-hover ? #2A2A2E : #222225;
                            border-width: 1px;
                            border-color: cancel-t.has-hover ? #404046 : #303034;
                            animate background { duration: 120ms; }

                            cancel-t := TouchArea {
                                clicked => { root.closed(); }
                            }

                            Text {
                                text: "Cancel";
                                font-size: 12px;
                                font-weight: 500;
                                color: cancel-t.has-hover ? #FFFFFF : #D1D1D6;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        // Add Paused Button
                        Rectangle {
                            height: 32px;
                            min-width: 116px;
                            border-radius: 7px;
                            background: later-t.pressed ? #323236 :
                                        later-t.has-hover ? #2C2C30 : #242428;
                            border-width: 1px;
                            border-color: later-t.has-hover ? #404046 : #303034;
                            animate background { duration: 120ms; }

                            later-t := TouchArea {
                                clicked => {
                                    root.confirm(root.url, root.filename, root.folder, root.description, false);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;

                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2;
                                    Icon {
                                        source: @image-url("../icons/clock.svg");
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: #D1D1D6;
                                    }
                                }

                                Text {
                                    text: "Add Paused";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: #E2E2E6;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Start Download Button
                        Rectangle {
                            height: 32px;
                            min-width: 128px;
                            border-radius: 7px;
                            background: start-t.pressed ? #0055B3 :
                                        start-t.has-hover ? #2394FF : #0A84FF;
                            drop-shadow-blur: start-t.has-hover ? 12px : 4px;
                            drop-shadow-color: #0A84FF66;
                            animate background { duration: 120ms; }

                            start-t := TouchArea {
                                clicked => {
                                    root.confirm(root.url, root.filename, root.folder, root.description, true);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2;
                                    Icon {
                                        source: @image-url("../icons/download.svg");
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: #FFFFFF;
                                    }
                                }

                                Text {
                                    text: "Start Download";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ══════════════════════════════════════════
        // CATEGORY DROPDOWN MENU (TOPMOST OVERLAY)
        // ══════════════════════════════════════════
        if root.category-dropdown-open: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: transparent;

            TouchArea {
                clicked => { root.category-dropdown-open = false; }
            }

            Rectangle {
                x: parent.width - 128px;
                y: 72px;
                width: 114px;
                border-radius: 8px;
                background: #1C1C20;
                border-width: 1px;
                border-color: #38383E;
                drop-shadow-blur: 24px;
                drop-shadow-color: #000000ee;

                TouchArea {}

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    for opt in ["General", "Compressed", "Programs", "Video", "Music", "Documents", "Pictures"]: Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: opt == root.category ? #0A84FF :
                                    c-t.has-hover ? #2A2A2E : transparent;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: start;

                            Text {
                                text: opt;
                                font-size: 11.5px;
                                font-weight: opt == root.category ? 600 : 400;
                                color: #FFFFFF;
                                vertical-alignment: center;
                            }
                        }

                        c-t := TouchArea {
                            clicked => {
                                root.category = opt;
                                root.category-changed(opt);
                                root.category-dropdown-open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
