import { ScrollView } from "std-widgets.slint";
import { ChunkInfo } from "../types.slint";
import { Icon } from "../components/icon.slint";
import { CaptionBtn, SettingsTabBtn } from "../components/buttons.slint";
import { SwitchRow, StepperControl } from "../components/inputs.slint";
import { Palette } from "../theme.slint";

// ════════════════════════════════════════════════
// Active Download Progress Dialog (IDM Modern Glass)
// ════════════════════════════════════════════════
export component DownloadProgressDialog inherits Window {
    width: 610px;
    height: show-details ? 420px : 250px;
    no-frame: true;
    background: transparent;
    title: root.percent-text + " " + root.filename;
    default-font-family: "Segoe UI Variable Display, Segoe UI, Inter, -apple-system, sans-serif";

    in-out property <string> task-id: "";
    in-out property <string> filename: "";
    in-out property <string> url: "";
    in-out property <string> save-path: "";
    in-out property <string> raw-status: "";
    in-out property <bool> is-error: false;
    in-out property <string> status-text: "Receiving data...";
    in-out property <string> total-size: "—";
    in-out property <string> downloaded-size: "0 B";
    in-out property <string> transfer-rate: "0 KB/s";
    in-out property <string> time-left: "—";
    in-out property <string> resume-capable: "Yes";
    in-out property <float> progress: 0.0;
    in-out property <string> percent-text: "0%";
    in-out property <bool> is-paused: false;
    in-out property <bool> is-torrent: false;
    in-out property <string> peers-info: "0 peers";
    in-out property <bool> show-details: true;
    in-out property <int> active-tab: 0;
    in-out property <bool> limit-on: false;
    in-out property <float> limit-mbps: 0;
    in-out property <bool> show-complete-dialog: true;
    in-out property <bool> shutdown-when-done: false;
    in-out property <bool> exit-when-done: false;
    in property <[ChunkInfo]> chunks: [];

    callback toggle-pause();
    callback cancel-download();
    callback renew-link();
    callback toggle-details();
    callback limit-changed(float);
    callback shutdown-changed(bool);
    callback exit-changed(bool);
    callback complete-dialog-changed(bool);
    callback minimize-window();
    callback closed();
    callback drag-window();
    // ponytail: no animate height here — animating a transparent frameless
    // window resizes + repaints the native surface every frame = hard lag

    Rectangle {
        width: 100%;
        height: 100%;
        x: 0;
        y: 0;
        border-radius: 12px;
        background: Palette.modal-bg;
        border-width: 1px;
        border-color: Palette.border-color;
        clip: true;

        VerticalLayout {
            // ── Title Bar (Blended seamless header) ──
            Rectangle {
                height: 38px;
                background: transparent;

                TouchArea {
                    pointer-event(pe) => {
                        if (pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.drag-window();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            Image {
                                source: @image-url("../icons/vdm.svg");
                                width: 16px;
                                height: 16px;
                            }
                        }

                        Text {
                            text: (root.percent-text != "" ? root.percent-text + "  " : "") + root.filename;
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.text-primary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;

                        CaptionBtn {
                            glyph: "─";
                            clicked => { root.minimize-window(); }
                        }
                        CaptionBtn {
                            glyph: "✕";
                            danger: true;
                            clicked => { root.closed(); }
                        }
                    }
                }
            }

            // ── Body ──
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 9px;

                // ── Segmented Tab Bar ──
                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: Palette.card-secondary-bg;

                    // Sliding indicator pill - matches active tab geometry exactly
                    Rectangle {
                        x: root.active-tab == 0 ? p-tab0.x : (root.active-tab == 1 ? p-tab1.x : p-tab2.x);
                        y: 2px;
                        width: root.active-tab == 0 ? p-tab0.width : (root.active-tab == 1 ? p-tab1.width : p-tab2.width);
                        height: parent.height - 4px;
                        border-radius: 5px;
                        background: Palette.hover-bg;
                        animate x { duration: 250ms; easing: cubic-bezier(0.2, 1.2, 0.4, 1); }
                        animate width { duration: 250ms; easing: cubic-bezier(0.2, 1.2, 0.4, 1); }
                    }

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 0px;

                        p-tab0 := SettingsTabBtn {
                            text: "Download status";
                            icon-src: @image-url("../icons/download.svg");
                            active: root.active-tab == 0;
                            horizontal-stretch: 1;
                            clicked => { root.active-tab = 0; }
                        }

                        p-tab1 := SettingsTabBtn {
                            text: "Speed Limiter";
                            icon-src: @image-url("../icons/cpu.svg");
                            active: root.active-tab == 1;
                            horizontal-stretch: 1;
                            clicked => { root.active-tab = 1; }
                        }

                        p-tab2 := SettingsTabBtn {
                            text: "Options on completion";
                            icon-src: @image-url("../icons/settings.svg");
                            active: root.active-tab == 2;
                            horizontal-stretch: 1;
                            clicked => { root.active-tab = 2; }
                        }
                    }
                }

                // ── Tab 0: Status ──
                if root.active-tab == 0: Rectangle {
                    height: 98px;
                    border-radius: 7px;
                    background: Palette.surface-bg;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 5px;

                        // URL Line with quick renew button
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "URL:";
                                width: 68px;
                                font-size: 11px;
                                color: Palette.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.url;
                                font-size: 11px;
                                color: Palette.accent-light;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 18px;
                                min-width: 58px;
                                border-radius: 4px;
                                background: ren-u.has-hover ? Palette.accent-tint-bg : Palette.card-secondary-bg;
                                border-width: 1px;
                                border-color: Palette.border-subtle;

                                ren-u := TouchArea {
                                    clicked => { root.renew-link(); }
                                }

                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    spacing: 3px;
                                    alignment: center;

                                    Icon {
                                        source: @image-url("../icons/refresh.svg");
                                        width: 9px;
                                        height: 9px;
                                        tint: Palette.accent-light;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "Renew";
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        color: Palette.accent-light;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Status Line
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "Status:";
                                width: 68px;
                                font-size: 11px;
                                color: Palette.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.is-paused ? "Paused" : root.status-text;
                                font-size: 11.5px;
                                font-weight: 600;
                                color: root.is-error ? Palette.danger : (root.is-paused ? Palette.warning : Palette.success);
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }

                        // 3-Column Crisp Meta Row
                        HorizontalLayout {
                            spacing: 12px;

                            // Col 1: File size & Downloaded
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "File size:"; width: 68px; font-size: 11px; color: Palette.text-secondary; }
                                    Text { text: root.total-size; font-size: 11px; font-weight: 500; color: Palette.text-primary; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Downloaded:"; width: 68px; font-size: 11px; color: Palette.text-secondary; }
                                    Text { text: root.downloaded-size + " (" + root.percent-text + ")"; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
                                }
                            }

                            // Col 2: Transfer rate & Time left
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Transfer rate:"; width: 74px; font-size: 11px; color: Palette.text-secondary; }
                                    Text { text: root.transfer-rate; font-size: 11px; font-weight: 600; color: Palette.accent-light; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Time left:"; width: 74px; font-size: 11px; color: Palette.text-secondary; }
                                    Text { text: root.time-left; font-size: 11px; font-weight: 600; color: Palette.text-primary; }
                                }
                            }

                            // Col 3: Resume capability / Peers
                            VerticalLayout {
                                width: 130px;
                                spacing: 3px;

                                if !root.is-torrent: HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Resume ability:"; width: 80px; font-size: 11px; color: Palette.text-secondary; }
                                    Text {
                                        text: root.is-error ? "No" : root.resume-capable;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: (root.is-error || root.resume-capable == "No") ? Palette.danger : Palette.success;
                                    }
                                }

                                if root.is-torrent: HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "Swarm / Peers:"; width: 80px; font-size: 11px; color: Palette.text-secondary; }
                                    Text {
                                        text: root.peers-info;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Palette.accent-light;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Tab 1: Speed Limiter ──
                if root.active-tab == 1: Rectangle {
                    height: 104px;
                    border-radius: 7px;
                    background: Palette.surface-bg;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: center;

                        SwitchRow {
                            title: "Enable Speed Limiter for this download";
                            subtitle: "Throttles connection bandwidth to prevent network congestion";
                            checked <=> root.limit-on;
                            toggled(on) => {
                                if !on { root.limit-changed(0); }
                                else { root.limit-changed(root.limit-mbps > 0 ? root.limit-mbps : 5.0); }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                text: "Maximum Download Speed:";
                                font-size: 11.5px;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            StepperControl {
                                width: 170px;
                                box-width: 100px;
                                text-val: root.limit-mbps <= 0.01 ? "Unlimited" : (root.limit-mbps + " MB/s");
                                can-decrease: root.limit-mbps > 0.5;
                                can-increase: root.limit-mbps < 200.0;
                                decrease => {
                                    root.limit-on = true;
                                    let next-val = root.limit-mbps <= 1.0 ? 0.5 : root.limit-mbps - 1.0;
                                    root.limit-mbps = next-val;
                                    root.limit-changed(next-val);
                                }
                                increase => {
                                    root.limit-on = true;
                                    let next-val = root.limit-mbps < 0.01 ? 1.0 : root.limit-mbps + 1.0;
                                    root.limit-mbps = next-val;
                                    root.limit-changed(next-val);
                                }
                                accepted(s) => {
                                    root.limit-on = true;
                                    let v = s.to-float();
                                    if v > 0 {
                                        root.limit-mbps = v;
                                        root.limit-changed(v);
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Tab 2: Options on completion ──
                if root.active-tab == 2: Rectangle {
                    height: 98px;
                    border-radius: 7px;
                    background: Palette.surface-bg;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        alignment: center;

                        // Save To info
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Save To:"; width: 68px; font-size: 11px; color: Palette.text-secondary; }
                            Text { text: root.save-path; font-size: 11px; color: Palette.text-primary; overflow: elide; horizontal-stretch: 1; }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: root.show-complete-dialog ? Palette.accent : Palette.card-secondary-bg;
                                animate background { duration: 120ms; }
                                TouchArea { clicked => { root.show-complete-dialog = !root.show-complete-dialog; root.complete-dialog-changed(root.show-complete-dialog); } }
                                if root.show-complete-dialog: Icon {
                                    source: @image-url("../icons/check.svg");
                                    width: 8px; height: 8px;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    tint: #FFFFFF;
                                }
                            }
                            Text {
                                text: "Show 'Download complete' dialog when finished";
                                font-size: 11px;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                                TouchArea { clicked => { root.show-complete-dialog = !root.show-complete-dialog; root.complete-dialog-changed(root.show-complete-dialog); } }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: root.shutdown-when-done ? Palette.accent : Palette.card-secondary-bg;
                                animate background { duration: 120ms; }
                                TouchArea { clicked => { root.shutdown-when-done = !root.shutdown-when-done; root.shutdown-changed(root.shutdown-when-done); } }
                                if root.shutdown-when-done: Icon {
                                    source: @image-url("../icons/check.svg");
                                    width: 8px; height: 8px;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    tint: #FFFFFF;
                                }
                            }
                            Text {
                                text: "Turn off computer when done";
                                font-size: 11px;
                                color: Palette.text-secondary;
                                vertical-alignment: center;
                                TouchArea { clicked => { root.shutdown-when-done = !root.shutdown-when-done; root.shutdown-changed(root.shutdown-when-done); } }
                            }
                        }
                    }
                }

                // ── Main Animated Progress Bar ──
                Rectangle {
                    height: 10px;
                    border-radius: 5px;
                    background: Palette.input-bg;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
                        height: 100%;
                        background: root.is-error ? @linear-gradient(90deg, #FF453A, #FF9F0A) : @linear-gradient(90deg, Palette.accent-gradient-start, Palette.accent-gradient-end);
                        animate width { duration: 150ms; }
                    }
                }

                // ── Controls Row: Details Toggle, Pause/Resume, Renew, Cancel ──
                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    // Toggle Details Button
                    Rectangle {
                        height: 28px;
                        min-width: 104px;
                        border-radius: 5px;
                        background: det-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                        animate background { duration: 120ms; }

                        det-t := TouchArea {
                            clicked => {
                                root.show-details = !root.show-details;
                                root.toggle-details();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 5px;
                            alignment: center;

                            Text {
                                text: root.show-details ? "« Hide details" : "» Show details";
                                font-size: 11.5px;
                                font-weight: 500;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Action Buttons (Renew Link, Pause/Resume/Retry, Cancel)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Dedicated Renew Link Button (Shown prominently on error, or accessible)
                        if root.is-error: Rectangle {
                            height: 28px;
                            min-width: 102px;
                            border-radius: 5px;
                            background: r-btn.pressed ? Palette.accent-pressed : r-btn.has-hover ? Palette.accent-hover : Palette.accent;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Palette.accent-tint-bg;
                            animate background { duration: 120ms; }

                            r-btn := TouchArea {
                                clicked => { root.renew-link(); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 5px;
                                alignment: center;

                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    y: (parent.height - self.height) / 2;
                                    Icon {
                                        source: @image-url("../icons/refresh.svg");
                                        width: 10px;
                                        height: 10px;
                                        tint: #FFFFFF;
                                    }
                                }

                                Text {
                                    text: "Renew Link";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Pause / Resume / Retry Button
                        Rectangle {
                            height: 28px;
                            min-width: 84px;
                            border-radius: 5px;
                            background: p-t.pressed ? Palette.hover-bg :
                                        p-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                            animate background { duration: 120ms; }

                            p-t := TouchArea {
                                clicked => { root.toggle-pause(); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 5px;
                                alignment: center;

                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    y: (parent.height - self.height) / 2;
                                    Icon {
                                        source: root.is-error ? @image-url("../icons/refresh.svg") :
                                                root.is-paused ? @image-url("../icons/play.svg") : @image-url("../icons/pause.svg");
                                        width: 10px;
                                        height: 10px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: root.is-error ? Palette.warning : (root.is-paused ? Palette.success : Palette.text-primary);
                                    }
                                }

                                Text {
                                    text: root.is-error ? "Retry" : (root.is-paused ? "Resume" : "Pause");
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: Palette.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Cancel Button
                        Rectangle {
                            height: 28px;
                            min-width: 72px;
                            border-radius: 5px;
                            background: c-t.pressed ? #3A2020 :
                                        c-t.has-hover ? #2D1E1E : Palette.card-secondary-bg;
                            animate background { duration: 120ms; }

                            c-t := TouchArea {
                                clicked => { root.cancel-download(); }
                            }

                            Text {
                                text: "Cancel";
                                font-size: 11.5px;
                                font-weight: 500;
                                color: c-t.has-hover ? Palette.danger : Palette.text-secondary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // ── Connection Segments & Live Chunk Scrollable Table (when show-details) ──
                // ponytail: visible: instead of `if` — keeps the subtree alive so
                // toggling costs one layout pass, no delegate re-instantiation
                VerticalLayout {
                    visible: root.show-details;
                    spacing: 5px;

                    Text {
                        text: "Start positions and download progress by connections";
                        font-size: 10.5px;
                        color: Palette.text-secondary;
                    }

                    // Multi-Segment Connection Bar
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Palette.input-bg;
                        clip: true;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
                            height: 100%;
                            background: root.is-error ? @linear-gradient(90deg, #FF453A, #FF9F0A) : @linear-gradient(90deg, Palette.accent-gradient-start, Palette.accent-gradient-end);
                        }
                    }

                    // Scrollable Thread Table
                    Rectangle {
                        height: 130px;
                        border-radius: 6px;
                        background: Palette.surface-bg;
                        clip: true;

                        VerticalLayout {
                            // Table Header (Fixed at top)
                            Rectangle {
                                height: 22px;
                                background: Palette.card-secondary-bg;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 14px;
                                    spacing: 8px;

                                    Text { text: "N."; width: 36px; font-size: 10px; font-weight: 700; color: Palette.text-secondary; vertical-alignment: center; }
                                    Text { text: "Downloaded"; width: 120px; font-size: 10px; font-weight: 700; color: Palette.text-secondary; vertical-alignment: center; }
                                    Text { text: "Info"; horizontal-stretch: 1; font-size: 10px; font-weight: 700; color: Palette.text-secondary; vertical-alignment: center; }
                                }
                            }

                            // Scrollable Table Rows
                            ScrollView {
                                height: 108px;
                                viewport-height: root.chunks.length * 20px + 6px;

                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 1px;

                                    for chunk in root.chunks: Rectangle {
                                        height: 19px;
                                        border-radius: 3px;
                                        background: Math.mod(chunk.id, 2) == 0 ? Palette.surface-subtle : transparent;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 10px;
                                            spacing: 8px;

                                            Text { text: chunk.id; width: 36px; font-size: 10.5px; color: Palette.text-secondary; vertical-alignment: center; }
                                            Text { text: chunk.downloaded; width: 120px; font-size: 10.5px; font-weight: 500; color: Palette.text-primary; vertical-alignment: center; }
                                            Text { text: chunk.status; horizontal-stretch: 1; font-size: 10.5px; color: chunk.status == "Finished" ? Palette.success : Palette.accent-light; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
