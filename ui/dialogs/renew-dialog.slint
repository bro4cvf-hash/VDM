import { Icon } from "../components/icon.slint";
import { CaptionBtn } from "../components/buttons.slint";
import { Field } from "../components/inputs.slint";
import { Palette } from "../theme.slint";

// ════════════════════════════════════════════════
// Renew Download Address Dialog (flat, borderless)
// ════════════════════════════════════════════════
export component RenewLinkDialog inherits Window {
    width: 590px;
    height: root.error-msg != "" ? 352px : 310px;
    no-frame: true;
    background: transparent;
    title: "Renew Download Address — " + root.filename;
    default-font-family: "Segoe UI Variable Display, Segoe UI, Inter, -apple-system, sans-serif";

    in-out property <string> task-id: "";
    in-out property <string> filename: "";
    in-out property <string> url: "";
    in-out property <string> new-url: "";
    in-out property <string> referrer: "";
    in-out property <string> error-msg: "";
    in-out property <string> downloaded-text: "";
    in-out property <float> progress: 0.0;
    in-out property <bool> is-listening: true;

    callback open-page(string);
    callback paste-clipboard();
    callback apply-url(string, string); // task-id, new-url
    callback retry-current(string);    // task-id
    callback closed();
    callback drag-window();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: Palette.modal-bg;
        border-width: 1px;
        border-color: Palette.border-color;
        clip: true;

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // ── Header (same color as body — one flat surface) ──
            Rectangle {
                height: 38px;

                TouchArea {
                    pointer-event(pe) => {
                        if (pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.drag-window();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    alignment: space-between;

                    Text {
                        text: "Renew Download Address (URL)";
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.text-primary;
                        vertical-alignment: center;
                    }

                    CaptionBtn {
                        glyph: "✕";
                        danger: true;
                        clicked => { root.closed(); }
                    }
                }
            }

            // ── Main Content Area ──
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 14px;
                spacing: 10px;

                // ── Error line (only when the task actually errored) ──
                if root.error-msg != "": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Icon {
                        source: @image-url("../icons/alert.svg");
                        width: 13px;
                        height: 13px;
                        tint: Palette.danger;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: root.error-msg;
                        font-size: 11.5px;
                        font-weight: 500;
                        color: Palette.danger;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                // ── File + progress bar ──
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        // icon box — layout-centered, can't drift or stretch
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 8px;
                            background: Palette.card-secondary-bg;
                            vertical-stretch: 0;

                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;

                                    Icon {
                                        source: @image-url("../icons/file.svg");
                                        width: 16px;
                                        height: 16px;
                                        tint: Palette.accent-light;
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.filename;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Palette.text-primary;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    // slim progress bar with the size text inside
                    Rectangle {
                        height: 15px;
                        border-radius: 5px;
                        background: Palette.input-bg;
                        clip: true;

                        Rectangle {
                            x: 0;
                            y: 0;
                            height: 100%;
                            width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
                            background: Palette.accent;
                        }

                        Text {
                            text: root.downloaded-text;
                            font-size: 9.5px;
                            font-weight: 600;
                            color: #FFFFFF;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // ── Auto Re-Capture ──
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "AUTO RE-CAPTURE";
                        font-size: 10px;
                        font-weight: 700;
                        color: Palette.accent;
                        letter-spacing: 0.5px;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: Palette.input-bg;
                            border-width: 1px;
                            border-color: Palette.border-color;
                            horizontal-stretch: 1;

                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: 100%;
                                text: (root.referrer != "" && root.referrer != "—") ? root.referrer : root.url;
                                font-size: 11px;
                                color: Palette.accent-light;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 145px;
                            height: 30px;
                            border-radius: 6px;
                            background: op-t.pressed ? Palette.accent-pressed : op-t.has-hover ? Palette.accent-hover : Palette.accent;
                            animate background { duration: 120ms; }

                            op-t := TouchArea {
                                clicked => {
                                    let target = (root.referrer != "" && root.referrer != "—") ? root.referrer : root.url;
                                    root.open-page(target);
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;

                                Icon {
                                    source: @image-url("../icons/globe.svg");
                                    width: 12px;
                                    height: 12px;
                                    tint: #FFFFFF;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Open Web Page";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Manual URL ──
                VerticalLayout {
                    spacing: 5px;

                    Text {
                        text: "NEW URL";
                        font-size: 10px;
                        font-weight: 700;
                        color: Palette.text-secondary;
                        letter-spacing: 0.5px;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Field {
                            h: 32px;
                            font-size: 11.5px;
                            radius: 6px;
                            text <=> root.new-url;
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            width: 78px;
                            height: 32px;
                            border-radius: 6px;
                            background: pst-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            animate background { duration: 120ms; }

                            pst-t := TouchArea {
                                clicked => { root.paste-clipboard(); }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 5px;

                                Icon {
                                    source: @image-url("../icons/copy.svg");
                                    width: 12px;
                                    height: 12px;
                                    tint: Palette.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Paste";
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    color: Palette.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ── Footer Action Buttons ──
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    Rectangle {
                        height: 32px;
                        min-width: 120px;
                        border-radius: 6px;
                        background: ret-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;
                        animate background { duration: 120ms; }

                        ret-t := TouchArea {
                            clicked => { root.retry-current(root.task-id); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            spacing: 5px;

                            Icon {
                                source: @image-url("../icons/refresh.svg");
                                width: 12px;
                                height: 12px;
                                tint: Palette.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Retry Current URL";
                                font-size: 11.5px;
                                font-weight: 500;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            height: 32px;
                            min-width: 72px;
                            border-radius: 6px;
                            background: cls-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            animate background { duration: 120ms; }

                            cls-t := TouchArea {
                                clicked => { root.closed(); }
                            }

                            Text {
                                text: "Cancel";
                                font-size: 11.5px;
                                font-weight: 500;
                                color: Palette.text-primary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Rectangle {
                            height: 32px;
                            min-width: 140px;
                            border-radius: 6px;
                            background: app-t.pressed ? Palette.accent-pressed : app-t.has-hover ? Palette.accent-hover : Palette.accent;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: Palette.accent-tint-bg;
                            animate background { duration: 120ms; }

                            app-t := TouchArea {
                                clicked => {
                                    let target_url = root.new-url != "" ? root.new-url : root.url;
                                    root.apply-url(root.task-id, target_url);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: center;
                                spacing: 6px;

                                Icon {
                                    source: @image-url("../icons/play.svg");
                                    width: 11px;
                                    height: 11px;
                                    tint: #FFFFFF;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Apply & Resume";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
