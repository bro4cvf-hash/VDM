import { Icon } from "../components/icon.slint";

// ════════════════════════════════════════════════
// Floating Mini-Pill (Dock / Tray Morph Widget)
// ════════════════════════════════════════════════
export component DownloadMiniPill inherits Window {
    width: 250px;
    height: 56px;
    no-frame: true;
    background: transparent;
    always-on-top: true;
    title: "VDM Download";
    default-font-family: "Segoe UI Variable Display, Segoe UI, Inter, -apple-system, sans-serif";

    in-out property <string> filename: "";
    in-out property <string> percent-text: "0%";
    in-out property <string> speed: "0 KB/s";
    in-out property <float> progress: 0.0;
    in-out property <bool> is-dragging: false;
    callback restore-dialog();
    callback drag-window();

    Rectangle {
        width: 100%;
        height: 100%;
        x: 0;
        y: 0;
        border-radius: 10px;
        background: #18181B;
        border-width: 1px;
        border-color: #323236;
        clip: true;

        TouchArea {
            pointer-event(pe) => {
                if pe.kind == PointerEventKind.down {
                    root.is-dragging = false;
                }
            }
            moved => {
                root.is-dragging = true;
                root.drag-window();
            }
            clicked => {
                if !root.is-dragging {
                    root.restore-dialog();
                }
            }
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 7px;
            padding-bottom: 6px;
            spacing: 5px;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                // Animated glowing mini icon
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: #0A84FF22;

                    Icon {
                        source: @image-url("../icons/zap.svg");
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: #0A84FF;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.filename;
                        font-size: 12px;
                        font-weight: 600;
                        color: #FFFFFF;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.percent-text;
                            font-size: 11px;
                            font-weight: 700;
                            color: #30D158;
                        }
                        Text {
                            text: "• " + root.speed;
                            font-size: 10.5px;
                            color: #8E8E93;
                        }
                    }
                }
            }

            // Integrated Mini Progress Bar
            Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: #28282C;
                clip: true;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
                    height: 100%;
                    background: @linear-gradient(90deg, #0A84FF, #30D158);
                    animate width { duration: 150ms; }
                }
            }
        }
    }
}
