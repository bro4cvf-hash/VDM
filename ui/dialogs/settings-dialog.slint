import { BrowserItem } from "../types.slint";
import { Icon } from "../components/icon.slint";
import { CaptionBtn, SettingsTabBtn } from "../components/buttons.slint";
import { SwitchRow, StepperControl, ThemeCard } from "../components/inputs.slint";
import { Palette } from "../theme.slint";
// ════════════════════════════════════════════════
// Settings & Browser Integration Dialog (Modern Minimalist)
// ════════════════════════════════════════════════
export component SettingsDialog inherits Window {
    width: 580px;
    height: 560px;
    no-frame: true;
    background: transparent;
    title: "Settings & Preferences";
    default-font-family: "Segoe UI Variable Display, Segoe UI, Inter, -apple-system, sans-serif";

    in property <[BrowserItem]> browsers;
    in-out property <int> active-tab: 0;
    in-out property <bool> show-info-modal: true;
    in-out property <int> max-active: 3;
    in-out property <int> max-connections: 8;
    in-out property <float> speed-limit-mbps: 0;
    in-out property <bool> start-at-startup: false;
    in-out property <string> close-action: "tray";
    in-out property <float> torrent-down-mbps: 0;
    in-out property <float> torrent-up-mbps: 0;
    in-out property <int> torrent-max-peers: 100;
    in-out property <bool> torrent-dht-enabled: true;
    in-out property <bool> torrent-pex-enabled: true;
    in-out property <bool> torrent-auto-trackers: true;

    callback install-extension(string);
    callback download-browser(string);
    callback open-extension-folder();
    callback set-max-active(int);
    callback set-max-connections(int);
    callback set-speed-limit(float);
    callback set-start-at-startup(bool);
    callback set-close-action(string);
    callback open-startup-apps();
    callback set-torrent-down-limit(float);
    callback set-torrent-up-limit(float);
    callback set-torrent-max-peers(int);
    callback set-torrent-dht-enabled(bool);
    callback set-torrent-pex-enabled(bool);
    callback set-torrent-auto-trackers(bool);
    callback set-theme(int);
    callback closed();
    callback drag-window();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 14px;
        background: Palette.modal-bg;
        border-width: 1px;
        border-color: Palette.border-color;
        clip: true;

        VerticalLayout {
            // ── Title Bar (Seamlessly blended with surface) ──
            Rectangle {
                height: 42px;
                background: transparent;

                TouchArea {
                    pointer-event(pe) => {
                        if (pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.drag-window();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: Palette.accent-tint-bg;

                            Icon {
                                source: @image-url("../icons/settings.svg");
                                width: 14px;
                                height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: Palette.accent-light;
                            }
                        }

                        Text {
                            text: "Settings & Preferences";
                            font-size: 13.5px;
                            font-weight: 700;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    CaptionBtn {
                        glyph: "✕";
                        danger: true;
                        clicked => { root.closed(); }
                    }
                }
            }

            // ── Main Body ──
            VerticalLayout {
                padding: 16px;
                spacing: 14px;

                // ── Segmented Tab Bar with Centered Apple Spring Indicator ──
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: Palette.card-secondary-bg;

                    // Springy sliding selection indicator pill - exact button geometry
                    Rectangle {
                        x: root.active-tab == 0 ? s-tab0.x : (root.active-tab == 1 ? s-tab1.x : (root.active-tab == 2 ? s-tab2.x : s-tab3.x));
                        y: 2px;
                        width: root.active-tab == 0 ? s-tab0.width : (root.active-tab == 1 ? s-tab1.width : (root.active-tab == 2 ? s-tab2.width : s-tab3.width));
                        height: parent.height - 4px;
                        border-radius: 6px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;
                        animate x { duration: 280ms; easing: cubic-bezier(0.2, 1.2, 0.4, 1); }
                        animate width { duration: 280ms; easing: cubic-bezier(0.2, 1.2, 0.4, 1); }
                    }

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 0px;

                        s-tab0 := SettingsTabBtn {
                            text: "Browsers";
                            icon-src: @image-url("../icons/globe.svg");
                            active: root.active-tab == 0;
                            horizontal-stretch: 1;
                            clicked => { root.active-tab = 0; }
                        }

                        s-tab1 := SettingsTabBtn {
                            text: "General";
                            icon-src: @image-url("../icons/zap.svg");
                            active: root.active-tab == 1;
                            horizontal-stretch: 1;
                            clicked => { root.active-tab = 1; }
                        }

                        s-tab2 := SettingsTabBtn {
                            text: "HTTP Speed";
                            icon-src: @image-url("../icons/cpu.svg");
                            active: root.active-tab == 2;
                            horizontal-stretch: 1;
                            clicked => { root.active-tab = 2; }
                        }

                        s-tab3 := SettingsTabBtn {
                            text: "BitTorrent";
                            icon-src: @image-url("../icons/layers.svg");
                            active: root.active-tab == 3;
                            horizontal-stretch: 1;
                            clicked => { root.active-tab = 3; }
                        }
                    }
                }

                // ── Tab 0: Browsers & Extensions ──
                if root.active-tab == 0: VerticalLayout {
                    spacing: 12px;

                    // Instructions Card
                    Rectangle {
                        border-radius: 8px;
                        background: Palette.accent-tint-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                Icon {
                                    source: @image-url("../icons/check.svg");
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: Palette.accent-light;
                                }
                            }

                            Text {
                                text: "1. Open chrome://extensions  •  2. Turn on 'Developer mode' (top right)  •  3. Click 'Load unpacked' and choose the VDM extension folder.";
                                font-size: 11px;
                                color: Palette.text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Browsers List Container (Clean Minimalist Column Layout)
                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            for b in root.browsers: Rectangle {
                                height: 42px;
                                border-radius: 7px;
                                background: b-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                                animate background { duration: 120ms; }

                                b-t := TouchArea {}

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    alignment: center;

                                    // Col 1: Icon + Browser Name
                                    HorizontalLayout {
                                        width: 160px;
                                        spacing: 10px;
                                        alignment: start;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            y: (parent.height - self.height) / 2;
                                            Icon {
                                                source: @image-url("../icons/globe.svg");
                                                width: 16px;
                                                height: 16px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                tint: b.running ? #30D158 : (b.installed ? Palette.accent : Palette.text-muted);
                                            }
                                        }

                                        Text {
                                            text: b.name;
                                            font-size: 12.5px;
                                            font-weight: 500;
                                            color: b.installed ? Palette.text-primary : Palette.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Col 2: Status Badge (Always fixed width 96px, perfectly column-aligned)
                                    Rectangle {
                                        width: 96px;
                                        height: 22px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 11px;
                                        background: b.running ? #30D15818 :
                                                    b.installed ? Palette.accent-tint-bg : Palette.card-bg;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;

                                            Rectangle {
                                                width: 5px;
                                                height: 5px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 2.5px;
                                                background: b.running ? #30D158 :
                                                            b.installed ? Palette.accent : Palette.text-muted;
                                            }

                                            Text {
                                                text: b.running ? "Active" :
                                                      b.installed ? "Installed" : "Not Found";
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                color: b.running ? #30D158 :
                                                       b.installed ? Palette.accent-light : Palette.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Spacer
                                    Rectangle { horizontal-stretch: 1; }

                                    // Col 3: Action Button (Always fixed width 126px, right-aligned, vertically centered)
                                    if b.installed: Rectangle {
                                        width: 126px;
                                        height: 28px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: inst-t.pressed ? Palette.accent-pressed :
                                                    inst-t.has-hover ? Palette.accent-hover : Palette.accent;
                                        animate background { duration: 120ms; }

                                        inst-t := TouchArea {
                                            clicked => { root.install-extension(b.id); }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;

                                            Rectangle {
                                                width: 10px;
                                                height: 10px;
                                                y: (parent.height - self.height) / 2;
                                                Icon {
                                                    source: @image-url("../icons/plus.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    tint: #FFFFFF;
                                                }
                                            }

                                            Text {
                                                text: "Install Extension";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: #FFFFFF;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if !b.installed: Rectangle {
                                        width: 126px;
                                        height: 28px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: get-t.pressed ? Palette.hover-bg :
                                                    get-t.has-hover ? Palette.hover-bg : Palette.card-bg;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;
                                        animate background { duration: 120ms; }

                                        get-t := TouchArea {
                                            clicked => { root.download-browser(b.id); }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;

                                            Rectangle {
                                                width: 10px;
                                                height: 10px;
                                                y: (parent.height - self.height) / 2;
                                                Icon {
                                                    source: @image-url("../icons/download.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    tint: Palette.text-secondary;
                                                }
                                            }

                                            Text {
                                                text: "Get Browser";
                                                font-size: 11px;
                                                font-weight: 500;
                                                color: get-t.has-hover ? Palette.text-primary : Palette.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Tab 1: General & Appearance ──
                if root.active-tab == 1: VerticalLayout {
                    spacing: 10px;

                    // ── Appearance & Theme Card (4 Themes with 5-Color Swatch Preview) ──
                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 1px;

                                    Text {
                                        text: "Appearance & Theme";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: "Select a color theme with unified surface palettes and typography";
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                ThemeCard {
                                    horizontal-stretch: 1;
                                    name: "Dark";
                                    active: Palette.active-theme == 0;
                                    c1: #1E1E1E;
                                    c2: #28282A;
                                    c3: #2C2C2E;
                                    c4: #0A84FF;
                                    c5: #64D2FF;
                                    clicked => {
                                        Palette.active-theme = 0;
                                        root.set-theme(0);
                                    }
                                }

                                ThemeCard {
                                    horizontal-stretch: 1;
                                    name: "OLED Black";
                                    active: Palette.active-theme == 4;
                                    c1: #000000;
                                    c2: #0D0D0E;
                                    c3: #141416;
                                    c4: #0A84FF;
                                    c5: #60A5FA;
                                    clicked => {
                                        Palette.active-theme = 4;
                                        root.set-theme(4);
                                    }
                                }

                                ThemeCard {
                                    horizontal-stretch: 1;
                                    name: "Light";
                                    active: Palette.active-theme == 1;
                                    c1: #F2F2F7;
                                    c2: #FFFFFF;
                                    c3: #E5E5EA;
                                    c4: #007AFF;
                                    c5: #1C1C1E;
                                    clicked => {
                                        Palette.active-theme = 1;
                                        root.set-theme(1);
                                    }
                                }

                                ThemeCard {
                                    horizontal-stretch: 1;
                                    name: "Dark Purple";
                                    active: Palette.active-theme == 2;
                                    c1: #161022;
                                    c2: #201731;
                                    c3: #2A1F40;
                                    c4: #AF52DE;
                                    c5: #DA8FFF;
                                    clicked => {
                                        Palette.active-theme = 2;
                                        root.set-theme(2);
                                    }
                                }

                                ThemeCard {
                                    horizontal-stretch: 1;
                                    name: "Ocean Slate";
                                    active: Palette.active-theme == 3;
                                    c1: #0B1120;
                                    c2: #151E32;
                                    c3: #1E293B;
                                    c4: #38BDF8;
                                    c5: #7DD3FC;
                                    clicked => {
                                        Palette.active-theme = 3;
                                        root.set-theme(3);
                                    }
                                }
                            }
                        }
                    }

                    // Windows Startup Integration Card
                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            SwitchRow {
                                title: "Start VDM on Windows Startup";
                                subtitle: "Launch VDM in the system tray automatically on system boot";
                                checked: root.start-at-startup;
                                toggled(val) => {
                                    root.start-at-startup = val;
                                    root.set-start-at-startup(val);
                                }
                            }

                            // Sub-card: Taskbar Startup Apps & Task Manager Integration status
                            Rectangle {
                                border-radius: 8px;
                                background: Palette.card-secondary-bg;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 10px;
                                    alignment: center;

                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        Icon {
                                            source: @image-url("../icons/zap.svg");
                                            width: 14px;
                                            height: 14px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            tint: root.start-at-startup ? #30D158 : Palette.text-muted;
                                        }
                                    }

                                    Text {
                                        text: root.start-at-startup
                                            ? "Connected & Enabled in Windows Task Manager & Taskbar Startup Apps."
                                            : "Disabled in Windows Startup. Turn on to launch automatically.";
                                        font-size: 11px;
                                        color: root.start-at-startup ? Palette.text-primary : Palette.text-secondary;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        height: 26px;
                                        border-radius: 6px;
                                        background: startup-btn-touch.pressed ? Palette.hover-bg :
                                                    startup-btn-touch.has-hover ? Palette.hover-bg : Palette.card-bg;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;
                                        animate background { duration: 120ms; }

                                        startup-btn-touch := TouchArea {
                                            clicked => { root.open-startup-apps(); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 5px;
                                            alignment: center;

                                            Rectangle {
                                                width: 11px;
                                                height: 11px;
                                                y: (parent.height - self.height) / 2;
                                                Icon {
                                                    source: @image-url("../icons/open.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    tint: Palette.text-secondary;
                                                }
                                            }

                                            Text {
                                                text: "Startup Apps";
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                color: startup-btn-touch.has-hover ? Palette.text-primary : Palette.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Window Close Action Card
                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                spacing: 8px;

                                VerticalLayout {
                                    spacing: 1px;

                                    Text {
                                        text: "Window Close Action (✕ Button)";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: "Configure behavior when closing the main VDM window";
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                // Option 1: Exit VDM completely
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 34px;
                                    border-radius: 6px;
                                    background: root.close-action == "exit" ? Palette.accent-tint-bg : (opt-exit-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg);
                                    border-width: 1px;
                                    border-color: root.close-action == "exit" ? Palette.accent : Palette.border-subtle;
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    opt-exit-t := TouchArea {
                                        clicked => {
                                            root.close-action = "exit";
                                            root.set-close-action("exit");
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            y: (parent.height - self.height) / 2;
                                            Icon {
                                                source: @image-url("../icons/x.svg");
                                                width: 11px;
                                                height: 11px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                tint: root.close-action == "exit" ? Palette.accent : Palette.text-secondary;
                                            }
                                        }

                                        Text {
                                            text: "Exit VDM completely";
                                            font-size: 11.5px;
                                            font-weight: root.close-action == "exit" ? 600 : 400;
                                            color: root.close-action == "exit" ? Palette.text-primary : Palette.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Option 2: Minimize to System Tray
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 34px;
                                    border-radius: 6px;
                                    background: root.close-action == "tray" ? Palette.accent-tint-bg : (opt-tray-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg);
                                    border-width: 1px;
                                    border-color: root.close-action == "tray" ? Palette.accent : Palette.border-subtle;
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    opt-tray-t := TouchArea {
                                        clicked => {
                                            root.close-action = "tray";
                                            root.set-close-action("tray");
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            y: (parent.height - self.height) / 2;
                                            Icon {
                                                source: @image-url("../icons/layers.svg");
                                                width: 12px;
                                                height: 12px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                tint: root.close-action == "tray" ? Palette.accent : Palette.text-secondary;
                                            }
                                        }

                                        Text {
                                            text: "Minimize to System Tray";
                                            font-size: 11.5px;
                                            font-weight: root.close-action == "tray" ? 600 : 400;
                                            color: root.close-action == "tray" ? Palette.text-primary : Palette.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;

                            Text {
                                text: "Automatic Category Routing";
                                font-size: 12px;
                                font-weight: 600;
                                color: Palette.text-primary;
                            }

                            Text {
                                text: "Files are automatically organized into standard folders based on extension (Compressed, Programs, Video, Music, Documents, and Pictures).";
                                font-size: 10.5px;
                                color: Palette.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ── Tab 2: Queue & Speed ──
                if root.active-tab == 2: VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 16px;

                            // Max Active Downloads
                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "Max Concurrent Downloads";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: "Active downloads allowed simultaneously (" + root.max-active + " active)";
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }

                                StepperControl {
                                    width: 140px;
                                    box-width: 76px;
                                    text-val: root.max-active + "";
                                    can-decrease: root.max-active > 1;
                                    can-increase: root.max-active < 16;
                                    decrease => {
                                        if root.max-active > 1 {
                                            root.max-active -= 1;
                                            root.set-max-active(root.max-active);
                                        }
                                    }
                                    increase => {
                                        if root.max-active < 16 {
                                            root.max-active += 1;
                                            root.set-max-active(root.max-active);
                                        }
                                    }
                                    accepted(s) => {
                                        let v = Math.round(s.to-float());
                                        if v >= 1 {
                                            root.max-active = Math.min(16, Math.max(1, v));
                                            root.set-max-active(root.max-active);
                                        }
                                    }
                                }
                            }

                            // Threads per Download
                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "Threads per Download";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: "Multi-connection acceleration parts (" + root.max-connections + " chunks)";
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }

                                StepperControl {
                                    width: 140px;
                                    box-width: 76px;
                                    text-val: root.max-connections + "";
                                    can-decrease: root.max-connections > 1;
                                    can-increase: root.max-connections < 64;
                                    decrease => {
                                        if root.max-connections > 1 {
                                            root.max-connections -= 1;
                                            root.set-max-connections(root.max-connections);
                                        }
                                    }
                                    increase => {
                                        if root.max-connections < 64 {
                                            root.max-connections += 1;
                                            root.set-max-connections(root.max-connections);
                                        }
                                    }
                                    accepted(s) => {
                                        let v = Math.round(s.to-float());
                                        if v >= 1 {
                                            root.max-connections = Math.min(64, Math.max(1, v));
                                            root.set-max-connections(root.max-connections);
                                        }
                                    }
                                }
                            }

                            // Global Speed Limiter
                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "Global Speed Limit";
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: root.speed-limit-mbps <= 0.01 ? "Unlimited bandwidth" : ("Capped at " + root.speed-limit-mbps + " MB/s");
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    width: 200px;
                                    spacing: 6px;
                                    alignment: end;

                                    StepperControl {
                                        width: 140px;
                                        box-width: 76px;
                                        text-val: root.speed-limit-mbps <= 0.01 ? "Max" : (root.speed-limit-mbps + " MB/s");
                                        can-decrease: root.speed-limit-mbps > 0.01;
                                        can-increase: root.speed-limit-mbps < 500.0;
                                        decrease => {
                                            if root.speed-limit-mbps <= 1.0 {
                                                root.speed-limit-mbps = 0;
                                            } else if root.speed-limit-mbps <= 10.0 {
                                                root.speed-limit-mbps -= 1.0;
                                            } else if root.speed-limit-mbps <= 50.0 {
                                                root.speed-limit-mbps -= 5.0;
                                            } else {
                                                root.speed-limit-mbps -= 10.0;
                                            }
                                            root.set-speed-limit(root.speed-limit-mbps);
                                        }
                                        increase => {
                                            if root.speed-limit-mbps < 0.01 {
                                                root.speed-limit-mbps = 1.0;
                                            } else if root.speed-limit-mbps < 10.0 {
                                                root.speed-limit-mbps += 1.0;
                                            } else if root.speed-limit-mbps < 50.0 {
                                                root.speed-limit-mbps += 5.0;
                                            } else {
                                                root.speed-limit-mbps += 10.0;
                                            }
                                            root.set-speed-limit(root.speed-limit-mbps);
                                        }
                                        accepted(s) => {
                                            let v = s.to-float();
                                            if v >= 0 {
                                                root.speed-limit-mbps = Math.min(500, v);
                                                root.set-speed-limit(root.speed-limit-mbps);
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 54px;
                                        height: 32px;
                                        border-radius: 7px;
                                        background: root.speed-limit-mbps <= 0.01 ? Palette.accent :
                                                    unlim-t.pressed ? Palette.hover-bg :
                                                    unlim-t.has-hover ? Palette.hover-bg : Palette.card-secondary-bg;
                                        border-width: 1px;
                                        border-color: root.speed-limit-mbps <= 0.01 ? Palette.accent : Palette.border-subtle;
                                        animate background { duration: 120ms; }

                                        unlim-t := TouchArea {
                                            clicked => {
                                                root.speed-limit-mbps = 0;
                                                root.set-speed-limit(0);
                                            }
                                        }

                                        Text {
                                            text: "Max";
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: root.speed-limit-mbps <= 0.01 ? #FFFFFF : (unlim-t.has-hover ? Palette.text-primary : Palette.text-secondary);
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Tab 3: BitTorrent & Magnet Acceleration ──
                if root.active-tab == 3: VerticalLayout {
                    spacing: 12px;

                    // Torrent Speed Limits Card
                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 14px;

                            Text {
                                text: "Bandwidth & Transfer Limits";
                                font-size: 12.5px;
                                font-weight: 700;
                                color: Palette.text-primary;
                            }

                            // Max Download Speed
                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "Max Torrent Download Speed";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: "Maximum incoming bandwidth for torrent swarms";
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }

                                StepperControl {
                                    width: 150px;
                                    box-width: 86px;
                                    text-val: root.torrent-down-mbps <= 0.01 ? "Unlimited" : (root.torrent-down-mbps + " MB/s");
                                    can-decrease: root.torrent-down-mbps > 0.5;
                                    can-increase: root.torrent-down-mbps < 500.0;
                                    decrease => {
                                        let next-val = root.torrent-down-mbps <= 1.0 ? 0.0 : root.torrent-down-mbps - 1.0;
                                        root.torrent-down-mbps = next-val;
                                        root.set-torrent-down-limit(next-val);
                                    }
                                    increase => {
                                        let next-val = root.torrent-down-mbps < 0.01 ? 1.0 : root.torrent-down-mbps + 1.0;
                                        root.torrent-down-mbps = next-val;
                                        root.set-torrent-down-limit(next-val);
                                    }
                                    accepted(s) => {
                                        let v = s.to-float();
                                        root.torrent-down-mbps = Math.max(0.0, v);
                                        root.set-torrent-down-limit(root.torrent-down-mbps);
                                    }
                                }
                            }

                            // Max Upload Speed
                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "Max Torrent Upload / Seeding Speed";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: "Prevent seeding from choking your local internet connection";
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }

                                StepperControl {
                                    width: 150px;
                                    box-width: 86px;
                                    text-val: root.torrent-up-mbps <= 0.01 ? "Unlimited" : (root.torrent-up-mbps + " MB/s");
                                    can-decrease: root.torrent-up-mbps > 0.5;
                                    can-increase: root.torrent-up-mbps < 200.0;
                                    decrease => {
                                        let next-val = root.torrent-up-mbps <= 1.0 ? 0.0 : root.torrent-up-mbps - 1.0;
                                        root.torrent-up-mbps = next-val;
                                        root.set-torrent-up-limit(next-val);
                                    }
                                    increase => {
                                        let next-val = root.torrent-up-mbps < 0.01 ? 1.0 : root.torrent-up-mbps + 1.0;
                                        root.torrent-up-mbps = next-val;
                                        root.set-torrent-up-limit(next-val);
                                    }
                                    accepted(s) => {
                                        let v = s.to-float();
                                        root.torrent-up-mbps = Math.max(0.0, v);
                                        root.set-torrent-up-limit(root.torrent-up-mbps);
                                    }
                                }
                            }
                        }
                    }

                    // Swarm & Discovery Acceleration Card
                    Rectangle {
                        border-radius: 10px;
                        background: Palette.card-bg;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            SwitchRow {
                                title: "Distributed Hash Table (DHT)";
                                subtitle: "Find peers quickly without relying solely on centralized trackers";
                                checked: root.torrent-dht-enabled;
                                toggled(val) => {
                                    root.torrent-dht-enabled = val;
                                    root.set-torrent-dht-enabled(val);
                                }
                            }

                            SwitchRow {
                                title: "Peer Exchange (PEX)";
                                subtitle: "Exchange peer lists directly with connected swarm members";
                                checked: root.torrent-pex-enabled;
                                toggled(val) => {
                                    root.torrent-pex-enabled = val;
                                    root.set-torrent-pex-enabled(val);
                                }
                            }

                            SwitchRow {
                                title: "Auto Public Tracker Acceleration";
                                subtitle: "Automatically inject high-tier public trackers for blazing-fast peer discovery";
                                checked: root.torrent-auto-trackers;
                                toggled(val) => {
                                    root.torrent-auto-trackers = val;
                                    root.set-torrent-auto-trackers(val);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;

                                    Text {
                                        text: "Max Peers per Torrent";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }

                                    Text {
                                        text: "Target peer swarm connections (" + root.torrent-max-peers + " peers)";
                                        font-size: 10.5px;
                                        color: Palette.text-secondary;
                                    }
                                }

                                StepperControl {
                                    width: 140px;
                                    box-width: 76px;
                                    text-val: root.torrent-max-peers + "";
                                    can-decrease: root.torrent-max-peers > 20;
                                    can-increase: root.torrent-max-peers < 500;
                                    decrease => {
                                        if root.torrent-max-peers > 20 {
                                            root.torrent-max-peers -= 20;
                                            root.set-torrent-max-peers(root.torrent-max-peers);
                                        }
                                    }
                                    increase => {
                                        if root.torrent-max-peers < 500 {
                                            root.torrent-max-peers += 20;
                                            root.set-torrent-max-peers(root.torrent-max-peers);
                                        }
                                    }
                                    accepted(s) => {
                                        let v = Math.round(s.to-float());
                                        if v >= 10 {
                                            root.torrent-max-peers = Math.min(500, Math.max(10, v));
                                            root.set-torrent-max-peers(root.torrent-max-peers);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ── Footer ──
                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    // Left Helper Action
                    HorizontalLayout {
                        alignment: start;

                        if root.active-tab == 0: Rectangle {
                            height: 32px;
                            border-radius: 7px;
                            background: fld-touch.pressed ? Palette.hover-bg :
                                        fld-touch.has-hover ? Palette.hover-bg : Palette.card-bg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            animate background { duration: 120ms; }

                            fld-touch := TouchArea {
                                clicked => { root.open-extension-folder(); }
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Rectangle {
                                    width: 13px;
                                    height: 13px;
                                    y: (parent.height - self.height) / 2;
                                    Icon {
                                        source: @image-url("../icons/folder.svg");
                                        width: 13px;
                                        height: 13px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: Palette.text-secondary;
                                    }
                                }

                                Text {
                                    text: "Open Extension Folder";
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    color: Palette.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Right Done Button
                    Rectangle {
                        width: 86px;
                        height: 32px;
                        border-radius: 7px;
                        background: done-touch.pressed ? Palette.accent-pressed :
                                    done-touch.has-hover ? Palette.accent-hover : Palette.accent;
                        drop-shadow-blur: done-touch.has-hover ? 10px : 3px;
                        drop-shadow-color: Palette.accent-tint-bg;
                        animate background { duration: 120ms; }

                        done-touch := TouchArea {
                            clicked => { root.closed(); }
                        }

                        Text {
                            text: "Done";
                            font-size: 12.5px;
                            font-weight: 700;
                            color: #FFFFFF;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }
}
