import { Icon } from "icon.slint";
import { Palette } from "../theme.slint";

// ── Styled text input (replaces std LineEdit chrome) ──
export component Field inherits Rectangle {
    forward-focus: ti;
    in property <string> placeholder: "";
    in-out property <string> text <=> ti.text;
    in property <length> h: 34px;
    in property <length> font-size: 13px;
    in property <length> radius: 6px;
    in property <length> pad-x: 10px;
    in property <bool> text-center: false;
    callback accepted();
    callback edited(string);

    height: h;
    border-radius: radius;
    clip: true;
    background: ti.has-focus ? Palette.input-focus-bg : Palette.input-bg;
    border-width: 1px;
    border-color: ti.has-focus ? Palette.accent : Palette.border-color;
    drop-shadow-blur: ti.has-focus ? 8px : 0px;
    drop-shadow-color: Palette.accent-tint-bg;
    animate border-color { duration: 160ms; }
    animate background { duration: 160ms; }
    animate drop-shadow-blur { duration: 160ms; }

    ti := TextInput {
        x: root.pad-x;
        y: 0;
        width: parent.width - root.pad-x * 2;
        height: 100%;
        horizontal-alignment: root.text-center ? center : left;
        vertical-alignment: center;
        single-line: true;
        color: Palette.text-primary;
        font-size: root.font-size;
        selection-background-color: Palette.accent;
        selection-foreground-color: #ffffff;
        accepted => { root.accepted(); }
        edited => { root.edited(ti.text); }
    }

    if ti.text == "": Text {
        x: root.pad-x;
        width: parent.width - root.pad-x * 2;
        height: parent.height;
        text: root.placeholder;
        font-size: root.font-size;
        color: Palette.text-tertiary;
        horizontal-alignment: root.text-center ? center : left;
        vertical-alignment: center;
    }
}

// ── Search field with growing magnifier ──
export component SearchField inherits Rectangle {
    forward-focus: ti;
    in-out property <string> text <=> ti.text;
    callback edited(string);

    width: 210px;
    height: 34px;
    border-radius: 8px;
    clip: true;
    background: ti.has-focus ? Palette.input-focus-bg : Palette.input-bg;
    border-width: 1px;
    border-color: ti.has-focus ? Palette.accent : Palette.border-color;
    drop-shadow-blur: ti.has-focus ? 10px : 0px;
    drop-shadow-color: Palette.accent-tint-bg;
    animate border-color { duration: 160ms; }
    animate background { duration: 160ms; }

    // icon well — hover here and the magnifier breathes
    Rectangle {
        x: 0;
        width: 32px;
        height: 100%;

        well := TouchArea {}

        Icon {
            source: @image-url("../icons/search.svg");
            width: well.has-hover || ti.has-focus ? 16px : 14px;
            height: well.has-hover || ti.has-focus ? 16px : 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: ti.has-focus ? Palette.accent-light : Palette.text-secondary;
            animate width { duration: 200ms; easing: cubic-bezier(0.3, 1.4, 0.4, 1); }
            animate height { duration: 200ms; easing: cubic-bezier(0.3, 1.4, 0.4, 1); }
            animate tint { duration: 160ms; }
        }
    }

    callback escape-pressed();

    ti := TextInput {
        x: 32px;
        y: 0;
        width: parent.width - 42px;
        height: 100%;
        vertical-alignment: center;
        single-line: true;
        color: Palette.text-primary;
        font-size: 13px;
        selection-background-color: Palette.accent;
        selection-foreground-color: #ffffff;
        edited => { root.edited(ti.text); }
        accepted => { ti.clear-focus(); root.escape-pressed(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                ti.text = "";
                root.edited("");
                ti.clear-focus();
                root.escape-pressed();
                return accept;
            } else if event.text == Key.DownArrow {
                ti.clear-focus();
                root.escape-pressed();
                return accept;
            }
            return reject;
        }
    }

    if ti.text == "": Text {
        x: 32px;
        height: parent.height;
        text: "Search";
        font-size: 13px;
        color: Palette.text-tertiary;
        vertical-alignment: center;
    }
}

// ── Modern Animated Switch Row ──
export component SwitchRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 44px;
    border-radius: 8px;
    background: row-touch.has-hover ? Palette.hover-bg : transparent;
    animate background { duration: 120ms; }

    row-touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 12.5px;
                font-weight: 500;
                color: Palette.text-primary;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 10.5px;
                color: Palette.text-secondary;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }

        // iOS / macOS style Toggle Pill
        Rectangle {
            width: 36px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: root.checked ? Palette.accent : Palette.border-color;
            animate background { duration: 180ms; easing: ease-out; }

            // Knob
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: #ffffff;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000044;
                animate x { duration: 180ms; easing: cubic-bezier(0.2, 1.2, 0.4, 1); }
            }
        }
    }
}

export component StepperControl inherits Rectangle {
    in-out property <string> text-val: "";
    in property <bool> can-decrease: true;
    in property <bool> can-increase: true;
    in property <length> box-width: 100px;
    callback decrease();
    callback increase();
    callback accepted(string);
    callback edited(string);

    height: 32px;
    border-radius: 7px;
    background: Palette.card-secondary-bg;

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 3px;
        alignment: center;

        // Minus Button [-]
        Rectangle {
            width: 28px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: !root.can-decrease ? transparent :
                        minus-t.pressed ? Palette.hover-bg :
                        minus-t.has-hover ? Palette.hover-bg : Palette.card-bg;
            animate background { duration: 100ms; }

            minus-t := TouchArea {
                enabled: root.can-decrease;
                clicked => { root.decrease(); }
            }

            Text {
                text: "−";
                font-size: 15px;
                font-weight: 700;
                color: !root.can-decrease ? Palette.text-muted :
                       minus-t.has-hover ? Palette.text-primary : Palette.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 1px;
            }
        }

        // Value Display & Editable Input Box
        Rectangle {
            width: root.box-width;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: val-in.has-focus ? Palette.input-focus-bg : Palette.input-bg;
            border-width: 1px;
            border-color: val-in.has-focus ? Palette.accent : Palette.border-subtle;
            clip: true;
            animate background { duration: 120ms; }

            val-in := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text-val;
                font-size: 11.5px;
                font-weight: 600;
                color: Palette.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Palette.accent;
                selection-foreground-color: #ffffff;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }

        // Plus Button [+]
        Rectangle {
            width: 28px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: !root.can-increase ? transparent :
                        plus-t.pressed ? Palette.hover-bg :
                        plus-t.has-hover ? Palette.hover-bg : Palette.card-bg;
            animate background { duration: 100ms; }

            plus-t := TouchArea {
                enabled: root.can-increase;
                clicked => { root.increase(); }
            }

            Text {
                text: "+";
                font-size: 15px;
                font-weight: 700;
                color: !root.can-increase ? Palette.text-muted :
                       plus-t.has-hover ? Palette.text-primary : Palette.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// ── Theme Selection Card with 5-Color Swatch Preview ──
export component ThemeCard inherits Rectangle {
    in property <string> name: "";
    in property <bool> active: false;
    in property <color> c1; // Base bg
    in property <color> c2; // Card / surface bg
    in property <color> c3; // Input / subtle bg
    in property <color> c4; // Primary accent
    in property <color> c5; // Text / highlight
    callback clicked();

    height: 72px;
    border-radius: 8px;
    background: root.active ? Palette.card-bg : (touch.has-hover ? Palette.hover-bg : Palette.card-secondary-bg);
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Palette.accent : (touch.has-hover ? Palette.border-color : Palette.border-subtle);
    drop-shadow-blur: root.active ? 8px : 0px;
    drop-shadow-color: Palette.accent-tint-bg;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    animate drop-shadow-blur { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 8px;
        alignment: space-between;

        // Top: 5 Palette Swatch Circles
        HorizontalLayout {
            spacing: 5px;
            alignment: start;

            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.c1;
                border-width: 1px;
                border-color: #0000002b;
            }
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.c2;
                border-width: 1px;
                border-color: #0000002b;
            }
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.c3;
                border-width: 1px;
                border-color: #0000002b;
            }
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.c4;
                border-width: 1px;
                border-color: #0000002b;
            }
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: root.c5;
                border-width: 1px;
                border-color: #0000002b;
            }
        }

        // Bottom row: Theme label + Active Checkmark Badge
        HorizontalLayout {
            alignment: space-between;
            spacing: 4px;

            Text {
                text: root.name;
                font-size: 11.5px;
                font-weight: root.active ? 700 : 500;
                color: root.active ? Palette.text-primary : Palette.text-secondary;
                vertical-alignment: center;
            }

            if root.active: Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: Palette.accent;

                Icon {
                    source: @image-url("../icons/check.svg");
                    width: 8px;
                    height: 8px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: #FFFFFF;
                }
            }
        }
    }
}
