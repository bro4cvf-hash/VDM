import { Icon } from "icon.slint";

// ── Styled text input (replaces std LineEdit chrome) ──
export component Field inherits Rectangle {
    forward-focus: ti;
    in property <string> placeholder: "";
    in-out property <string> text <=> ti.text;
    in property <length> h: 34px;
    in property <length> font-size: 13px;
    in property <length> radius: 6px;
    in property <length> pad-x: 10px;
    in property <bool> text-center: false;
    callback accepted();
    callback edited(string);

    height: h;
    border-radius: radius;
    clip: true;
    background: ti.has-focus ? #232325 : #18181A;
    border-width: 1px;
    border-color: ti.has-focus ? #0A84FF : #3A3A3C;
    drop-shadow-blur: ti.has-focus ? 8px : 0px;
    drop-shadow-color: #0A84FF44;
    animate border-color { duration: 160ms; }
    animate background { duration: 160ms; }
    animate drop-shadow-blur { duration: 160ms; }

    ti := TextInput {
        x: root.pad-x;
        y: 0;
        width: parent.width - root.pad-x * 2;
        height: 100%;
        horizontal-alignment: root.text-center ? center : left;
        vertical-alignment: center;
        single-line: true;
        color: #f5f5f7;
        font-size: root.font-size;
        selection-background-color: #0A84FF;
        selection-foreground-color: #ffffff;
        accepted => { root.accepted(); }
        edited => { root.edited(ti.text); }
    }

    if ti.text == "": Text {
        x: root.pad-x;
        width: parent.width - root.pad-x * 2;
        height: parent.height;
        text: root.placeholder;
        font-size: root.font-size;
        color: #7C7C80;
        horizontal-alignment: root.text-center ? center : left;
        vertical-alignment: center;
    }
}

// ── Search field with growing magnifier ──
export component SearchField inherits Rectangle {
    forward-focus: ti;
    in-out property <string> text <=> ti.text;
    callback edited(string);

    width: 210px;
    height: 34px;
    border-radius: 8px;
    clip: true;
    background: ti.has-focus ? #232325 : #2C2C2E;
    border-width: 1px;
    border-color: ti.has-focus ? #0A84FF : #3A3A3C;
    drop-shadow-blur: ti.has-focus ? 10px : 0px;
    drop-shadow-color: #0A84FF33;
    animate border-color { duration: 160ms; }
    animate background { duration: 160ms; }

    // icon well — hover here and the magnifier breathes
    Rectangle {
        x: 0;
        width: 32px;
        height: 100%;

        well := TouchArea {}

        Icon {
            source: @image-url("../icons/search.svg");
            width: well.has-hover || ti.has-focus ? 16px : 14px;
            height: well.has-hover || ti.has-focus ? 16px : 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: ti.has-focus ? #64D2FF : #7C7C80;
            animate width { duration: 200ms; easing: cubic-bezier(0.3, 1.4, 0.4, 1); }
            animate height { duration: 200ms; easing: cubic-bezier(0.3, 1.4, 0.4, 1); }
            animate tint { duration: 160ms; }
        }
    }

    ti := TextInput {
        x: 32px;
        y: 0;
        width: parent.width - 42px;
        height: 100%;
        vertical-alignment: center;
        single-line: true;
        color: #f5f5f7;
        font-size: 13px;
        selection-background-color: #0A84FF;
        selection-foreground-color: #ffffff;
        edited => { root.edited(ti.text); }
        accepted => { ti.clear-focus(); }
    }

    if ti.text == "": Text {
        x: 32px;
        height: parent.height;
        text: "Search";
        font-size: 13px;
        color: #7C7C80;
        vertical-alignment: center;
    }
}

// ── Modern Animated Switch Row ──
export component SwitchRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 44px;
    border-radius: 8px;
    background: row-touch.has-hover ? #242426 : transparent;
    animate background { duration: 120ms; }

    row-touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 12.5px;
                font-weight: 500;
                color: #f5f5f7;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 10.5px;
                color: #8E8E93;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }

        // iOS / macOS style Toggle Pill
        Rectangle {
            width: 36px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: root.checked ? #0A84FF : #3A3A3C;
            animate background { duration: 180ms; easing: ease-out; }

            // Knob
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: #ffffff;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000055;
                animate x { duration: 180ms; easing: cubic-bezier(0.2, 1.2, 0.4, 1); }
            }
        }
    }
}

export component StepperControl inherits Rectangle {
    in-out property <string> text-val: "";
    in property <bool> can-decrease: true;
    in property <bool> can-increase: true;
    in property <length> box-width: 100px;
    callback decrease();
    callback increase();
    callback accepted(string);
    callback edited(string);

    height: 32px;
    border-radius: 7px;
    background: #18181B;

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 3px;
        alignment: center;

        // Minus Button [-]
        Rectangle {
            width: 28px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: !root.can-decrease ? transparent :
                        minus-t.pressed ? #2C2C30 :
                        minus-t.has-hover ? #242428 : #1E1E22;
            animate background { duration: 100ms; }

            minus-t := TouchArea {
                enabled: root.can-decrease;
                clicked => { root.decrease(); }
            }

            Text {
                text: "−";
                font-size: 15px;
                font-weight: 700;
                color: !root.can-decrease ? #48484A :
                       minus-t.has-hover ? #FFFFFF : #C7C7CC;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - 1px;
            }
        }

        // Value Display & Editable Input Box
        Rectangle {
            width: root.box-width;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: val-in.has-focus ? #242428 : #131315;
            clip: true;
            animate background { duration: 120ms; }

            val-in := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text-val;
                font-size: 11.5px;
                font-weight: 600;
                color: #FFFFFF;
                horizontal-alignment: center;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: #0A84FF;
                selection-foreground-color: #ffffff;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }

        // Plus Button [+]
        Rectangle {
            width: 28px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: !root.can-increase ? transparent :
                        plus-t.pressed ? #2C2C30 :
                        plus-t.has-hover ? #242428 : #1E1E22;
            animate background { duration: 100ms; }

            plus-t := TouchArea {
                enabled: root.can-increase;
                clicked => { root.increase(); }
            }

            Text {
                text: "+";
                font-size: 15px;
                font-weight: 700;
                color: !root.can-increase ? #48484A :
                       plus-t.has-hover ? #FFFFFF : #C7C7CC;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}
