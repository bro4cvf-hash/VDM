import { Icon } from "icon.slint";

export component CaptionBtn inherits Rectangle {
    in property <string> glyph: "";
    in property <bool> danger: false;
    callback clicked();

    width: 40px;
    height: 100%;
    border-radius: 7px;
    background: touch.pressed ? (danger ? #b33a30 : #3A3A3C) :
                touch.has-hover ? (danger ? #FF453A : #ffffff14) : transparent;
    animate background { duration: 150ms; easing: ease-out; }

    if !danger: Text {
        text: root.glyph;
        font-size: 13px;
        font-weight: 500;
        color: touch.has-hover ? #ffffff : #98989D;
        animate color { duration: 150ms; }
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if danger: Icon {
        source: @image-url("../icons/x.svg");
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: touch.has-hover ? #ffffff : #98989D;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ── Primary accent button: gradient + glow ──
export component PrimaryBtn inherits Rectangle {
    in property <string> text: "";
    in property <image> icon-src;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <length> h: 34px;
    in property <length> pad-x: 12px;
    in property <length> font-size: 13px;
    callback clicked();

    height: h;
    border-radius: 8px;
    background: !enabled ? #0A84FF44 :
                touch.pressed ? #0068D1 :
                touch.has-hover ? @linear-gradient(180deg, #3AA0FF, #1E90FF) :
                @linear-gradient(180deg, #2394FF, #0A84FF);
    drop-shadow-blur: 12px;
    drop-shadow-color: !enabled ? transparent : touch.has-hover ? #0A84FF88 : #0A84FF44;
    animate background { duration: 150ms; easing: ease-out; }
    animate drop-shadow-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        spacing: 7px;
        alignment: center;

        if has-icon: Rectangle {
            width: 16px;

            Icon {
                source: root.icon-src;
                width: 15px;
                height: 15px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: #ffffff;
            }
        }

        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: 600;
            color: !enabled ? #ffffff88 : #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ── Row icon button with hover highlight & delayed tooltip ──
export component IconBtn inherits Rectangle {
    in property <image> icon-src;
    in property <string> tip-text: "";
    in property <color> tint: #98989D;
    in property <bool> danger: false;
    callback clicked();
    in-out property <bool> tip: false;

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: touch.pressed ? #48484a : touch.has-hover ? (danger ? #FF453A26 : #3A3A3C) : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? (danger ? #FF453A44 : #48484a) : transparent;
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if !self.has-hover { root.tip = false; }
        }
    }

    // 0.8s hold before the tooltip appears
    Timer {
        interval: 800ms;
        running: touch.has-hover;
        triggered => { root.tip = true; }
    }

    Icon {
        source: root.icon-src;
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: touch.has-hover ? (danger ? #ff8077 : #ffffff) : root.tint;
        animate tint { duration: 130ms; }
    }

    if root.tip-text != "": Rectangle {
        width: tip-t.preferred-width + 16px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: -28px + (root.tip ? 0px : 3px);
        border-radius: 6px;
        background: #28282A;
        border-width: 1px;
        border-color: #48484a;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000aa;
        opacity: root.tip ? 1 : 0;
        animate opacity { duration: 180ms; easing: ease-out; }
        animate y { duration: 180ms; easing: ease-out; }

        tip-t := Text {
            x: 8px;
            y: (parent.height - self.height) / 2;
            text: root.tip-text;
            font-size: 11px;
            font-weight: 500;
            color: #e5e5ea;
        }
    }
}

export component SettingsTabBtn inherits Rectangle {
    in property <string> text: "";
    in property <image> icon-src;
    in property <bool> active: false;
    callback clicked();

    min-width: 0px;
    background: transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            Icon {
                source: root.icon-src;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.active ? #0A84FF : (touch.has-hover ? #FFFFFF : #8E8E93);
                animate tint { duration: 120ms; }
            }
        }

        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? #FFFFFF : (touch.has-hover ? #FFFFFF : #98989D);
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }
}
