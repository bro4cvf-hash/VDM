import { Icon } from "icon.slint";

// -- macOS Sonoma / Apple HIG Context Menu Row --
export component ContextMenuItem inherits Rectangle {
    in property <string> label: "";
    in property <image> icon-src;
    in property <color> tint: #98989D;
    in property <string> shortcut: "";
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> has-submenu: false;
    in property <bool> is-active: false;
    callback clicked();
    callback hovered(bool);

    height: 28px;
    border-radius: 6px;
    background: !root.enabled ? transparent :
                root.danger && touch.has-hover ? #FF453A22 :
                touch.has-hover || root.is-active ? #2A2A30 : transparent;
    border-width: 1px;
    border-color: !root.enabled ? transparent :
                  root.danger && touch.has-hover ? #FF453A44 :
                  touch.has-hover || root.is-active ? #383840 : transparent;
    x: (touch.has-hover && root.enabled) || root.is-active ? 2px : 0px;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }
    animate x { duration: 140ms; easing: cubic-bezier(0.3, 1.3, 0.4, 1); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        // Fixed icon container for strict uniform alignment
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;

            Icon {
                source: root.icon-src;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: !root.enabled ? #55555A :
                      root.danger && touch.has-hover ? #FF6B5E :
                      touch.has-hover || root.is-active ? #FFFFFF : root.tint;
                animate tint { duration: 120ms; }
            }
        }

        // Label
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: !root.enabled ? 400 : (touch.has-hover || root.is-active ? 600 : 500);
            color: !root.enabled ? #55555A :
                   root.danger && touch.has-hover ? #FF6B5E :
                   touch.has-hover || root.is-active ? #FFFFFF : #D1D1D6;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            animate color { duration: 120ms; }
        }

        // Right accessory: Submenu indicator or shortcut badge
        if root.has-submenu: Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;

            Icon {
                source: @image-url("../icons/chevron-right.svg");
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: !root.enabled ? #444448 : touch.has-hover || root.is-active ? #FFFFFF : #7C7C80;
                animate tint { duration: 120ms; }
            }
        }

        if !root.has-submenu && root.shortcut != "": Text {
            text: root.shortcut;
            font-size: 10.5px;
            font-weight: 500;
            color: !root.enabled ? #444448 : touch.has-hover ? #A1A1A6 : #6E6E73;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// -- Context Menu Subtle Separator --
export component ContextMenuSeparator inherits Rectangle {
    height: 7px;

    Rectangle {
        y: 3px;
        height: 1px;
        width: 100%;
        background: #2A2A2E;
    }
}

// -- Submenu Item --
export component SubmenuItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> is-selected: false;
    in property <image> icon-src;
    in property <bool> has-icon: false;
    in property <color> tint: #98989D;
    callback clicked();

    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? #2A2A30 : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? #383840 : transparent;
    x: touch.has-hover ? 2px : 0px;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }
    animate x { duration: 140ms; easing: cubic-bezier(0.3, 1.3, 0.4, 1); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        if root.has-icon: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;

            Icon {
                source: root.icon-src;
                width: 13px;
                height: 13px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: touch.has-hover ? #FFFFFF : root.tint;
                animate tint { duration: 120ms; }
            }
        }

        if !root.has-icon && root.is-selected: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;

            Icon {
                source: @image-url("../icons/check.svg");
                width: 11px;
                height: 11px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: #0A84FF;
            }
        }

        if !root.has-icon && !root.is-selected: Rectangle {
            width: 16px;
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: touch.has-hover ? 600 : (root.is-selected ? 600 : 450);
            color: touch.has-hover ? #FFFFFF : (root.is-selected ? #0A84FF : #D1D1D6);
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
